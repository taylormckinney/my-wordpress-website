{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "skills-plugin/skills-block",
  "version": "0.1.0",
  "title": "Skills Block",
  "category": "widgets",
  "icon": "screenoptions",
  "description": "Block used for displaying a list of skills, stylized as separate div objects.",
  "example": {},
  "supports": {
    "align": true,
    "color": true,
    "spacing": true,
    "html": true
  },
  "textdomain": "skills-block",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "attributes": {
    "skillsList": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "default": ""
      }
    }
  }
}